# VELA — server-side settings. Copy to .env; never put keys in VITE_* variables.
# Blank credentials are intentional. This template contains no real secrets.

# Application — active in the current scaffold
NODE_ENV=development
PORT=3000
SQLITE_PATH=./data/vela.sqlite

# Future engine — these switches DO NOT implement an agent or order execution.
# demo | shadow | live. Keep demo until the engine is implemented and tested.
TRADING_MODE=demo
AGENT_ENABLED=false
LIVE_TRADING_ENABLED=false

# Wallex REST — official account-specific API key, sent as x-api-key.
# For the challenge, use the CREDIT ACCOUNT key, not a personal/main-account key.
# Only read/trade permissions are needed; withdrawal is not part of this app.
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_API_KEY=
WALLEX_API_KEY_EXPIRES_AT=
WALLEX_ACCOUNT_TYPE=credit
# Reference identifiers for verification; NOT authentication headers.
WALLEX_SUB_ACCOUNT_ID=
WALLEX_PACKAGE_ID=
WALLEX_HTTP_TIMEOUT_MS=10000
# Local client budget; not a claim about the exchange-wide rate limit.
WALLEX_READ_REQUESTS_PER_SECOND=2
# Official create-order limit: at most 20 requests / 10 seconds.
WALLEX_ORDER_REQUESTS_PER_10_SECONDS=10
WALLEX_READ_MAX_RETRIES=2
# Never blindly retry an ambiguous order submission; reconcile client_id first.
WALLEX_ORDER_CLIENT_ID_PREFIX=VELA
WALLEX_ACCOUNT_POLL_INTERVAL_MS=15000

# Public read-only price feed — Centrifugo V2, NOT deprecated /ws or socket.io.
WALLEX_WS_ENABLED=true
WALLEX_WS_URL=wss://api.wallex.ir/connection/websocket
WALLEX_WS_RECONNECT_MIN_MS=1000
WALLEX_WS_RECONNECT_MAX_MS=30000
# SDK should handle protocol ping/pong; do not add a fixed manual heartbeat.
# Private V2 streams need cookie-authenticated refresh, NOT just x-api-key.
# Private stream login/refresh is intentionally outside this scaffold; use REST.

# Market-data repository — planned, not implemented.
# Comma-separated exact symbols from Wallex; empty means no markets selected.
MARKET_DATA_SYMBOLS=
MARKET_DATA_MAX_AGE_MS=15000
# REST candle resolutions: 1,15,60,240,480,720,1D,2D,3D
MARKET_CANDLE_RESOLUTION=15
MARKET_HISTORY_LOOKBACK_DAYS=30
MARKET_SNAPSHOT_INTERVAL_MS=5000
MARKET_AI_CONTEXT_MAX_CANDLES=100

# LLM — BoxAPI; exact provider model ID verified against its public model catalog.
# Base URL should end at its API root, e.g. the provider's /v1, not /chat/completions.
# Integration contract planned here: OpenAI-compatible Chat Completions HTTP API.
LLM_API_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_HTTP_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_RETRIES=1
# Hard local call budget for the FUTURE agent; not a provider token/price quota.
LLM_MAX_CALLS_PER_DAY=200

# Future agent decisions — log input, model response and accepted/rejected action.
AGENT_DECISION_INTERVAL_MS=60000
AGENT_STRATEGY_VERSION=vela_v1
AGENT_PROMPT_VERSION=decision_v1
AGENT_SAVE_DECISION_INPUTS=true

# Optional MCP integration. Not required for direct Wallex REST; not implemented.
# Enter only the exact URL/auth mechanism supplied by the challenge organizer.
WALLEX_MCP_ENABLED=false
WALLEX_MCP_SERVER_URL=
WALLEX_MCP_AUTH_TOKEN=

# Challenge/risk — planned guards, not enforced by an execution engine yet.
# TMN is TOMAN, not IRR. Amount caps below are in TOMAN; 0 disables new entries.
CHALLENGE_INITIAL_CAPITAL_TMN=5000000
CHALLENGE_START_AT=
CHALLENGE_END_AT=
# ISO 8601 with timezone, e.g. 2026-10-22T18:00:00+03:30 (example only).
CHALLENGE_EXIT_BEFORE_END_MINUTES=30
# Organizer's exact allowed markets. Empty = trading forbidden; never infer a list.
TRADING_ALLOWED_SYMBOLS=
TRADING_BLOCKED_SYMBOLS=
TRADING_QUOTE_ASSET=TMN
TRADING_ORDER_TYPE=LIMIT
RISK_MAX_ORDER_TMN=0
RISK_MAX_TOTAL_EXPOSURE_TMN=0
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_DRAWDOWN_PERCENT=0
RISK_STOP_LOSS_PERCENT=0
RISK_MAX_SPREAD_BPS=0
RISK_MAX_SLIPPAGE_BPS=0
# Fetch actual per-market maker/taker fees and precision; never assume zero fees.
RISK_REQUIRE_VERIFIED_FEES=true

TRADING_MARKET_TYPE=margin

EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_BATCH_SIZE=8

EMBEDDING_MAX_DOCUMENTS_PER_JOB=100
